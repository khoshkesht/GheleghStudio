<IfModule php8_module>
   php_value error_log "/home/h426822/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/h426822/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect legacy multi-page URLs to their sections on the single-page site.
  # NE keeps the # fragment intact in the Location header.
  RewriteRule ^games\.html$ /index.html#games [R=301,L,NE]
  RewriteRule ^radino\.html$ /index.html#radino [R=301,L,NE]
  RewriteRule ^hoosh-up\.html$ /index.html#hoosh-up [R=301,L,NE]
  RewriteRule ^about\.html$ /index.html#about [R=301,L,NE]
  RewriteRule ^contact\.html$ /index.html#contact [R=301,L,NE]
</IfModule>
